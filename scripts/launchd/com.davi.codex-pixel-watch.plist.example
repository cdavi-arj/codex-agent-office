<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.davi.codex-pixel-watch</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/absolute/path/to/codex-agent-office/scripts/codex-agent-watch.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/absolute/path/to/codex-agent-office</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/codex-pixel-watch.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/codex-pixel-watch.err.log</string>
</dict>
</plist>
